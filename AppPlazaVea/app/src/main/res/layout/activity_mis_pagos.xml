<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MisPagosActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:title="Mis Pagos"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SECCIÓN: Métodos de pago -->
    <TextView
        android:id="@+id/tvTituloMetodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 Métodos de pago"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        app:layout_constraintTop_toBottomOf="@id/my_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvMetodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Visa  ****  ****  ****  1234\n• Mastercard  ****  ****  ****  5678\n• Yape  →  999-999-999"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMetodos"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp" />

    <!-- SECCIÓN: Últimos pagos -->
    <TextView
        android:id="@+id/tvTituloUltimos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧾 Últimos pagos"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        app:layout_constraintTop_toBottomOf="@id/tvMetodos"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvUltimosPagos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• S/ 45.90   →   Ayer   →   Visa 1234\n• S/ 120.00  →   Lunes   →   Yape\n• S/ 32.50   →   Sábado   →   Mastercard 5678"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloUltimos"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp" />

    <!-- SECCIÓN: Saldo pendiente -->
    <TextView
        android:id="@+id/tvTituloSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 Saldo pendiente"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        app:layout_constraintTop_toBottomOf="@id/tvUltimosPagos"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S/ 0.00  ✅  ¡Estás al día!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/tvTituloSaldo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp" />

    <!-- Botón Agregar método de pago -->
    <Button
        android:id="@+id/btnAgregarPago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agregar método de pago"
        app:layout_constraintTop_toBottomOf="@id/tvSaldo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
