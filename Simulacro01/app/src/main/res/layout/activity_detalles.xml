<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".Detalles">

    <ImageView
        android:id="@+id/adIvProducto"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/imagen_producto"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/adTvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Nombre"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adTvCodigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Código"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/adTvCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Categoría"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/adTvPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Precio"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/adTvStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Stock"
        android:textSize="16sp" />

</LinearLayout>
