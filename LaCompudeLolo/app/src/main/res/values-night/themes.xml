<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LaCompudeLolo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <!-- ¡ESTA ES LA LÍNEA QUE FALTABA! -->
    <style name="Theme.LaCompudeLolo" parent="Base.Theme.LaCompudeLolo" />

    <!-- Tu tema para el Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Usa el ícono de la app como logo del splash -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- El tema que se aplicará después del splash -->
        <item name="postSplashScreenTheme">@style/Theme.LaCompudeLolo</item>
    </style>
</resources>